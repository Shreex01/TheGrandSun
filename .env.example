VITE_SUPABASE_URL=https://ypxltlqmpryctsiknrdm.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
APP_URL=http://localhost:5173

# Supabase Edge Function secrets (never expose these with a VITE_ prefix).
# Keep APP_URL set to the exact storefront origin for deployment, such as
# https://store.example.com. This origin is used by Edge Function CORS.
# Set the following for local function serving and with `supabase secrets set` when deployed.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Only needed for the legacy Payment Link webhook, not Standard Checkout.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
